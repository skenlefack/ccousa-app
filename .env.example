# =====================================================
# CCOUSA-APP - Variables d'Environnement
# Copier ce fichier en .env et modifier les valeurs
# =====================================================

# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development
APP_NAME=CCOUSA-APP
APP_VERSION=1.0.0

# ============================================
# DATABASE PostgreSQL
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ccousa_db
DB_USER=ccousa_user
DB_PASSWORD=your_secure_database_password_here

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# API GATEWAY
# ============================================
API_GATEWAY_PORT=8000
API_GATEWAY_RATE_LIMIT=100
API_GATEWAY_RATE_WINDOW=60000

# ============================================
# SMTP / EMAIL
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@ccousa-app.cm
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME=CCOUSA-APP
SMTP_FROM_EMAIL=noreply@ccousa-app.cm

# ============================================
# FILE UPLOADS
# ============================================
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=CCOUSA-APP
VITE_DEFAULT_LANGUAGE=fr

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ============================================
# SSL/TLS (Production)
# ============================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/certificate.crt
SSL_KEY_PATH=/etc/ssl/private/private.key
